<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LH" android:textSize="36sp" android:textStyle="bold"
            android:textColor="@color/white" android:background="@drawable/bg_primary" android:padding="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Quản lý lịch hẹn"
            android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/ink"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Đăng nhập để tiếp tục"
            android:textSize="16sp" android:gravity="center" android:textColor="@color/muted"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="20dp">
            <TextView style="@style/FieldLabel" android:text="Tên đăng nhập" android:labelFor="@id/etUsername"/>
            <EditText android:id="@+id/etUsername" style="@style/FormInput"
                android:hint="Nhập tên đăng nhập" android:inputType="textNoSuggestions" android:singleLine="true" android:autofillHints="username"/>
            <TextView style="@style/FieldLabel" android:layout_marginTop="16dp" android:text="Mật khẩu" android:labelFor="@id/etPassword"/>
            <EditText android:id="@+id/etPassword" style="@style/FormInput"
                android:hint="Nhập mật khẩu" android:inputType="textPassword" android:singleLine="true" android:autofillHints="password"/>
            <TextView android:id="@+id/tvLoginError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/danger" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
            <Button android:id="@+id/btnLogin" style="@style/PrimaryButton" android:layout_marginTop="20dp" android:text="Đăng nhập"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center" android:text="Tài khoản mẫu: admin / 123456" android:textColor="@color/muted"/>
    </LinearLayout>
</ScrollView>